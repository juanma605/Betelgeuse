# Copiá esto a `.env` y completá. El .env está en .gitignore y nunca se commitea.
# config.yaml los lee con la sintaxis "env:NOMBRE".

# Alertas por mail (alerts.email en config.yaml).
SMTP_HOST=smtp.gmail.com
SMTP_USER=
# Con Gmail: contraseña de aplicación, no la de tu cuenta.
SMTP_PASSWORD=
# A quién avisarle cuando aparece algo sobre min_score.
ALERT_TO=

# MercadoLibre. Hoy la fuente está apagada en config.yaml: la búsqueda pide
# una app certificada y sin eso devuelve 403 aunque el token sea válido.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_ACCESS_TOKEN=
